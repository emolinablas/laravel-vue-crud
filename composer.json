{
    "name": "emolinablas/laravel-vue-crud",
    "description": "Laravel CRUD genérico con Vue 2 (v1.x — LTS parches de seguridad)",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ever Molina",
            "email": "moulinaem@gmail.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": "^7.4|^8.0|^8.1|^8.2|^8.3",
        "laravel/framework": "^8.0|^9.0|^10.0|^11.0|^12.0",
        "intervention/image": "^2.5"
    },
    "autoload": {
        "psr-4": {
            "Emolinablas\\LaravelVueCrud\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Emolinablas\\LaravelVueCrud\\LaravelVueCrudServiceProvider"
            ],
            "aliases": {
                "Vuecrud": "Emolinablas\\LaravelVueCrud\\Facades\\LaravelVueCrud"
            }
        }
    }
}
